# ============================================================
# INTEL CRM — Environment Configuration
# Copy this file to .env.local (Next.js dev) and to your
# Vercel Project > Settings > Environment Variables for prod.
# NEVER commit the real .env.local file. NEVER expose these
# in client-side code — only server (API routes) may read them.
# ============================================================

# --- Database (Supabase) ---------------------------------------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon key — safe to expose to the browser, used for read-only
# realtime/UI convenience only. All writes go through server API routes
# using the service role key below.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Grants full DB access. Never prefix
# with NEXT_PUBLIC_. Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Provider -------------------------------------------------------
# Which provider the abstraction layer routes to. "gemini" is the
# supported, required path. "openai" is a stub adapter for the future —
# it is NOT required and the app works fully without it.
AI_PROVIDER=gemini

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# SERVER ONLY.
GEMINI_API_KEY=your-gemini-api-key

# Gemini model to use for research/generation. Pick a current model from
# https://ai.google.dev/gemini-api/docs/models at deploy time.
GEMINI_MODEL=gemini-2.0-flash

# --- Optional: OpenAI adapter (not required) --------------------------
# OPENAI_API_KEY=

# --- Agent cost/behavior limits -----------------------------------------
AGENT_MAX_DISCOVERY_SEARCHES=6
AGENT_MAX_CANDIDATES_PER_RUN=25
AGENT_MAX_DEEP_RESEARCH=10

# --- Cron / scheduled job auth -------------------------------------------
# Vercel Cron calls /api/agent/scheduled with this shared secret in the
# Authorization header (Bearer). Generate a random string.
CRON_SECRET=change-me-to-a-random-string

# --- App auth (single-user) ----------------------------------------------
# Simple shared-secret login since this is a solo-user internal tool.
# Generate a strong random string.
APP_LOGIN_PASSWORD=change-me
APP_SESSION_SECRET=change-me-too-random-32-bytes
